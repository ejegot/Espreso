<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]" data-application="elilai-kafe-employee">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="description" content="ELIlai Kafe employee operations" />
    <meta name="theme-color" content="#394331" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="ELIlai Kafe" />
    <.live_title default="ELIlai Kafe" suffix=" · ELIlai Kafe">
      {assigns[:page_title]}
    </.live_title>
    <link rel="manifest" href={~p"/elilai-kafe.webmanifest"} />
    <link rel="apple-touch-icon" href={~p"/images/elilai-kafe/apple-touch-icon.png"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=Fraunces:ital,opsz,wght@0,9..144,600;0,9..144,700;1,9..144,600;1,9..144,700&family=Figtree:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="site-body elilai-kafe-employee-root" id="site-smooth" phx-hook="SmoothScroll">
    {@inner_content}
  </body>
</html>
